# Agent tooling (local-only)
.qoder/
.claude/
.ainow/
.agent/
.agent-docs/
*.sqlite

# Archived Kaioken workspaces and legacy trees
/.kaio/
.kaio/

# Third-party source vendored for reading only, not built or shipped.
# See .reference/README.md for what is here and why.
.reference/

# Full opencode and pi clone at repo root, read-only reference material — not the
# vendored .reference/opencode/ sparse checkout, kept separately because it
# has packages/{llm,app,console,...} that one omits. Never built or shipped;
# ignored so it can't land in a commit by accident (it carries node_modules).
/opencode/
/pi/

# Website
website/node_modules/
website/dist/

# Desktop app
kaioken v1/desktop/node_modules/
kaioken v1/desktop/dist/
kaioken v1/desktop/src-tauri/target/
kaioken v1/desktop/src-tauri/binaries/
kaioken v1/desktop/src-tauri/gen/
kaioken v1/desktop/src-tauri/target/release/bundle/
desktop/node_modules/
desktop/dist/
desktop/out/
*.tsbuildinfo

# OS files
Thumbs.db
.DS_Store

# Nested reference repo with its own .git — not part of this repository, same
# treatment as opencode/. Committing it would create a stray gitlink.
kaioken v1/cli/PRISM_RAG/

# The GitHub Wiki, cloned locally for editing (github.com/babtix/kaioken.wiki.git).
# It has its own .git, is pushed to its own remote, and neither site's build reads
# it — tracking it here only produced a gitlink with no .gitmodules to resolve it,
# which is what caused "Failed to fetch one or more git submodules" on every clone.
/kaioken v1/wiki/

# web-news
web-news/node_modules/
web-news/dist/
web-news/.vercel/

# Per-repo generated caches. The wiki and knowledge cards are committed on
# purpose — these are not: the search index is a rebuildable derivative that
# churns on every generation, mcp.json embeds an absolute binary path, and the
# MCP bearer token is a credential.
**/.kaioken/search_index.json
**/.kaioken/mcp.json
**/.kaioken/mcp_token

# CLI Release packages
kaioken v1/cli/release/

# website_pre prototype app
website_pre/node_modules/
website_pre/dist/
website_pre/.vite/

# Environment & secret files
.env
.env.*
*.env
!.env.example

# Logs & debug outputs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Image & media assets (screenshots, raw renders, and media files)
*.png
*.jpeg
*.jpg
*.gif
*.webp
*.mp4
*.zip
*.7z
*.rar

# Allow required app icons and favicons
!kaioken v1/desktop/src-tauri/icons/**
!desktop/resources/**
!desktop/src/renderer/src/assets/**

# Allow website images (needed for the Vercel build)
!website/src/assets/**
!website/public/assets/**
!**/public/favicon.*
!**/public/icons/**
!/assets/**
!website/public/**
!kaioken-site/public/**


# IDE & Editor settings
.vscode/
.idea/


# Vendored read-only reference checkouts (pi, opencode, hermes-agent).
# ~1.6GB of third-party source kept locally for analysis; never committed.
inspire/

# Kaioken Studio experiments and IDE worktrees (VS Code and Theia upstream clones)
ide_kaioken/
kaioken_studio/
kaioken_studio_theia/
kaioken_main_STUDIO/

# Archived, superseded top-level projects, kept locally for reference but not
# tracked going forward - same treatment as kaioken_studio/ above.
#   .kaioken_v1/    - the original Go implementation (kaioken v1/, renamed).
#   .kaio_site_old/ - the previous iteration of the marketing site.
.kaioken_v1/
.kaio_site_old/

# Kaioken's own generated local state when run against this repo (index,
# scan cache, search index) - not source.
/.kaioken/

# Scratch output from manually exercising the bundle/export command.
kaioken_bundle_test/

.vercel
.env*

