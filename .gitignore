kaioken v1/cli/kaioken_new.exe
kaioken v1/cli/kaioken-new.exe
*.exe
kaioken v1/cli/kaioken-test

# GoReleaser output (snapshot and release builds)
/kaioken v1/dist/
/kaioken v1/release/
