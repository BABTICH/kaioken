{
  "name": "kaioken-desktop",
  "version": "0.8.1",
  "description": "Grounded agent runtime with deterministic truth, hard verification, and desktop-grade safety.",
  "author": {
    "name": "Kaioken Labs",
    "url": "https://github.com/babtix"
  },
  "license": "L0-NC-2.0.1",
  "homepage": "https://github.com/babtix/kaioken-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/babtix/kaioken-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/babtix/kaioken-desktop/issues"
  },
  "main": "out/main/index.js",
  "bin": {
    "kaioken": "./bin/kaioken.js"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "desktop:dev": "electron-vite dev",
    "build": "electron-vite build",
    "desktop:build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ci": "npm run build && playwright test",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "release": "npx tsx scripts/release.ts",
    "postinstall": "electron-builder install-app-deps",
    "clean": "node -e \"const fs=require('fs');['out','dist'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.10.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.1",
    "@nanostores/react": "^0.8.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-icons": "^1.3.0",
    "@tanstack/react-query": "^5.101.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "electron-updater": "^6.3.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.26.0",
    "mermaid": "^11.16.1",
    "motion": "^12.42.0",
    "nanostores": "^0.11.3",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.36.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "kaioken",
    "agent",
    "electron",
    "desktop",
    "ai",
    "typescript"
  ]
}
