{
  "name": "kaioken",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build && node packages/index/scripts/copy-queries.mjs",
    "typecheck": "tsc --build --force",
    "test": "npm run build && vitest run",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
