      "name": "extractFile",
      "file": "kaioken/index/src/extract.ts",
      "note": "Extracts symbols and re-exports from a single file into a FileMap"
    },
    {
      "name": "SymbolOracle",
      "file": "kaioken/index/src/oracle.ts",
      "note": "Query interface: lookup by name/path, resolve imports, get exported symbols"
    },
